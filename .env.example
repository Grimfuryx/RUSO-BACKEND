# Copy this file to ".env" and fill in real values. NEVER commit ".env".
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<your-cluster>.mongodb.net/ruso?retryWrites=true&w=majority

# Min 12 characters. Generate a secure random password with:
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=your_strong_random_admin_password_here

PORT=4000

# Comma-separated sites allowed to call this API (no trailing slash).
# Local testing: your Live Server address. Production: your domain(s).
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000